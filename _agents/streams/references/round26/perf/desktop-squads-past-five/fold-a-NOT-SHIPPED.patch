+	assert_eq(game_match.load_doctrine(Match.Team.GREEN, sides[0]["fielded"]), "", "setup: his army spawns")
+	assert_eq(game_match.load_doctrine(Match.Team.RUST, sides[1]["fielded"]), "", "setup: the CPU spawns")
+	var orders := Orders.new()
