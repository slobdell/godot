+// P3 PROTOTYPE (perf, round 26): see tank_native.h. The GDScript (tank_brain.gd _think_rate):
+//   for known in contact_prototypes(team).values():          # name order = ContactsTable order
+//     distance := my_position.distance_to(known["position"])  # float32 math, widened
+//     if distance > LOD_RADIUS: continue
+//     if distance <= maxf(my_reach, known["weapon_range"] + FIGHT_MARGIN): fight
+//     near = true
+Dictionary TankNative::rate_classes(const Dictionary &reach_by_unit, double lod_radius, double margin) {
+	const uint64_t t0 = Time::get_singleton()->get_ticks_usec();
+	Dictionary out;
+	const int n = records.size();
+	const float *f32 = records.f32.ptr();
+	const int32_t *i32 = records.i32.ptr();
+	for (int r = 0; r < n; r++) {
+		const Variant reach_v = reach_by_unit.get(records.units[r], Variant());
+		if (reach_v.get_type() == Variant::NIL) {
+			continue;
+		}
+		const double my_reach = double(reach_v);
+		const int team = i32[r * RecordLayout::I32_STRIDE + RecordLayout::TEAM];
+		if (team < 0 || team > 1) {
+			continue;
+		}
+		const ContactsTable &table = contacts[team];
+		const Vector3 me(f32[r * RecordLayout::F32_STRIDE + RecordLayout::POS], f32[r * RecordLayout::F32_STRIDE + RecordLayout::POS + 1],
+				f32[r * RecordLayout::F32_STRIDE + RecordLayout::POS + 2]);
+		const float *cf = table.f32.ptr();
+		const double *cd = table.f64.ptr();
+		int cls = 0;
+		for (int c = 0; c < table.size(); c++) {
+			const Vector3 at(cf[c * ContactLayout::F32_STRIDE + ContactLayout::POS], cf[c * ContactLayout::F32_STRIDE + ContactLayout::POS + 1],
+					cf[c * ContactLayout::F32_STRIDE + ContactLayout::POS + 2]);
+			const double distance = double(me.distance_to(at));
+			if (distance > lod_radius) {
+				continue;
+			}
+			const double theirs = cd[c * ContactLayout::F64_STRIDE + ContactLayout::WEAPON_RANGE] + margin;
+			if (distance <= (my_reach > theirs ? my_reach : theirs)) {
+				cls = 2;
+				break;
+			}
+			cls = 1;
+		}
+		out[records.names[r]] = cls;
+	}
+	last_rate_usec = int64_t(Time::get_singleton()->get_ticks_usec() - t0);
+	return out;
+}
+
+
+int TankNative::rate_class_one(const String &name, double reach, double lod_radius, double margin) {
+	const uint64_t t0 = Time::get_singleton()->get_ticks_usec();
+	const int32_t *found = records.index.getptr(name);
+	int cls = -1;
+	if (found != nullptr) {
+		const int r = *found;
+		const int team = records.i32[r * RecordLayout::I32_STRIDE + RecordLayout::TEAM];
+		if (team >= 0 && team <= 1) {
+			const ContactsTable &table = contacts[team];
+			const float *f32 = records.f32.ptr();
+			const Vector3 me(f32[r * RecordLayout::F32_STRIDE + RecordLayout::POS], f32[r * RecordLayout::F32_STRIDE + RecordLayout::POS + 1],
+					f32[r * RecordLayout::F32_STRIDE + RecordLayout::POS + 2]);
+			const float *cf = table.f32.ptr();
+			const double *cd = table.f64.ptr();
+			cls = 0;
+			for (int c = 0; c < table.size(); c++) {
+				const Vector3 at(cf[c * ContactLayout::F32_STRIDE + ContactLayout::POS], cf[c * ContactLayout::F32_STRIDE + ContactLayout::POS + 1],
+						cf[c * ContactLayout::F32_STRIDE + ContactLayout::POS + 2]);
+				const double distance = double(me.distance_to(at));
+				if (distance > lod_radius) {
+					continue;
+				}
+				const double theirs = cd[c * ContactLayout::F64_STRIDE + ContactLayout::WEAPON_RANGE] + margin;
+				if (distance <= (reach > theirs ? reach : theirs)) {
+					cls = 2;
+					break;
+				}
+				cls = 1;
+			}
+		}
+	}
+	rate_one_usec += int64_t(Time::get_singleton()->get_ticks_usec() - t0);
+	return cls;
+}
+
 } // namespace godot
