# Godot's per-machine cache (import results, class cache). Regenerated by `make import`.
.godot/

# Pinned toolchain downloaded by `make bootstrap` (Godot editor + export templates).
.tools/
# ...and the same name without a slash: in a worktree .tools is a *symlink* to the main checkout's toolchain, and
# a pattern ending in "/" never matches a symlink. Without this line `git add -A` commits the link, and checking it
# out in the main checkout replaces the real 300 MB toolchain with a link to itself (audio, 2026-09-16).
.tools

# Everything `make` produces: web export, server binary, screenshots.
build/

# Web smoke-test harness dependencies (`make web-smoke` installs them).
node_modules/

# Per-worktree isolation files written by tools/worktree.sh (ports, Godot user dir).
local.mk
override.cfg

# Editor/OS noise
*.tmp
*.translation
.DS_Store

# Python bytecode from the announcer and audio tools.
__pycache__/
*.pyc
