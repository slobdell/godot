# Godot's per-machine cache (import results, class cache). Regenerated by `make import`.
.godot/

# Pinned toolchain downloaded by `make bootstrap` (Godot editor + export templates). In a worktree `.tools` is a
# SYMLINK to the main checkout's copy, and `.tools/` alone does not match a symlink, so every worktree agent saw it
# as untracked (combat, 2026-09-16). Both lines are needed.
.tools
.tools/

# Everything `make` produces: web export, server binary, screenshots.
build/

# Web smoke-test harness dependencies (`make web-smoke` installs them).
node_modules/

# Per-worktree isolation files written by tools/worktree.sh (ports, Godot user dir).
local.mk
override.cfg

# Editor/OS noise
*.tmp
*.translation
.DS_Store
