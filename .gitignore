# Godot's per-machine cache (import results, class cache). Regenerated by `make import`.
.godot/

# Pinned toolchain downloaded by `make bootstrap` (Godot editor + export templates). Both forms are needed: in a
# worktree `.tools` is a SYMLINK to the main checkout's copy, and a pattern ending in "/" never matches a symlink.
# Without the slashless line `git add -A` commits the link, and checking it out in the main checkout replaces the real
# 300 MB toolchain with a link to itself (it happened on 2026-09-16, from two streams in one night).
.tools
.tools/

# Everything `make` produces: web export, server binary, screenshots.
build/

# The native library (round 23): this worktree's CMake tree and the .so + .gdextension `make native` writes; never
# committed, each machine builds its own (mk/native.mk, _agents/native.md). godot-cpp itself lives under .tools/.
native/build/
native/bin/

# Web smoke-test harness dependencies (`make web-smoke` installs them).
node_modules/

# Per-worktree isolation files written by tools/worktree.sh (ports, Godot user dir).
local.mk
override.cfg

# Editor/OS noise
*.tmp
*.translation
.DS_Store

# Python bytecode from the announcer and audio tools.
__pycache__/
*.pyc
/.laptop-tp/
native/build-android/
native/bin-android/
