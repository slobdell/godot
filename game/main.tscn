[gd_scene format=3]

[ext_resource type="Script" path="res://game/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://game/arena/arena.tscn" id="2_arena"]
[ext_resource type="Script" path="res://game/camera/follow_camera.gd" id="3_camera"]

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="Arena" parent="." instance=ExtResource("2_arena")]

[node name="Tanks" type="Node3D" parent="."]

[node name="TankSpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Tanks")

[node name="FollowCamera" type="Camera3D" parent="."]
script = ExtResource("3_camera")
current = true
fov = 55.0

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Status" type="Label" parent="HUD"]
offset_left = 12.0
offset_top = 8.0
offset_right = 900.0
offset_bottom = 40.0
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 18
