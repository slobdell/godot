[gd_scene format=3]

[ext_resource type="Script" path="res://game/match/match.gd" id="1_match"]

[sub_resource type="SceneReplicationConfig" id="ReplicationConfig_score"]
properties/0/path = NodePath(".:score_green")
properties/0/spawn = true
properties/0/replication_mode = 2
properties/1/path = NodePath(".:score_rust")
properties/1/spawn = true
properties/1/replication_mode = 2

[node name="Match" type="Node"]
script = ExtResource("1_match")

[node name="TankSpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Tanks")

[node name="ShellSpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Shells")

[node name="Tanks" type="Node3D" parent="."]

[node name="Shells" type="Node3D" parent="."]

[node name="Effects" type="Node3D" parent="."]

[node name="Brains" type="Node" parent="."]

[node name="ScoreSync" type="MultiplayerSynchronizer" parent="."]
replication_config = SubResource("ReplicationConfig_score")
